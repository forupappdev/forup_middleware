unit forup.data.mongodb;

interface
uses forup.data.intf, System.Classes, System.StrUtils, System.SysUtils, System.JSON,
System.JSON.Types, System.JSON.Writers, FireDAC.Comp.Client, DataSet.Serialize, FireDAC.Stan.Param,
FireDAC.Phys.MongoDBDataSet, FireDAC.Phys.MongoDB, FireDAC.Phys.MongoDBCli, FireDAC.Phys.MongoDBWrapper,
FireDAC.Phys.MongoDBDef;

type
  {$M+}
  TFUPMongoData = class(TFUPDataAcces, IDataAcces)
    protected
      FCollection : String;
      FDataBase: string;
    public
      function InsertObject(aObj : TJSONValue) : TJSONValue; override;
      function UpdateObject(aObj : TJSONValue) : TJSONValue; override;
      function GetObject(aID : string; aFrom : string) : TJSONValue; override;
      function GetObjects(aFilter : TJSONValue) : TJSONValue; override;
      function DeleteObject(aID : string; aFrom : string) : TJSONValue; override;
      function DeleteObjects(aFilter : TJSONValue) : TJSONValue; override;
    published
      property Collection: string read FCollection write FCollection;
      property DataBase: string read FDataBase write FDataBase;

  end;




implementation
uses forup.constants, forup.main_connection, forup.log_unit, forup.helpers;

{ TFUPMongoData }

function TFUPMongoData.DeleteObject(aID, aFrom: string): TJSONValue;
begin
  Result := nil;
end;

function TFUPMongoData.DeleteObjects(aFilter: TJSONValue): TJSONValue;
begin
  Result := nil;
end;

function TFUPMongoData.GetObject(aID, aFrom: string): TJSONValue;
begin
  Result := nil;
end;

function TFUPMongoData.GetObjects(aFilter: TJSONValue): TJSONValue;
begin
  Result := nil;
end;

function TFUPMongoData.InsertObject(aObj: TJSONValue): TJSONValue;
var
  _Env : TMongoEnv;
  _Doc : TMongoDocument;
  _LastID: string;
  aGUID : TGUID;
  oCurs : IMongoCursor;
begin
  if main_connection.TryMongoConnect(_Env) then
    begin
      try
        try
          if CreateGUID(aGUID) = S_OK then
            _LastID := TFUPFuncHelper.AlphaNumeric(GUIDToString(aGUID));

          _Doc := aObj.GetMongoDocument(_Env);
          _Doc.Add('tracker', _LastID);
          main_connection.FMongoConn[DataBase][Collection].Insert(_Doc);

          oCurs := main_connection.FMongoConn[DataBase][Collection].Find()
            .Match('{"tracker":"'+_LastID+'"}').&End;

          while oCurs.Next do
            Result := TJSONObject.ParseJSONValue(oCurs.Doc.AsJSON);
        except
          on e : exception do
            begin
              if aObj is TJSONObject then
                TLogger.GetInstance().Log(
                  TLogLevel.llFailure,
                  'mongo_insert_document',
                  'Trying to Insert doc into Collection: '+Self.FCollection,
                  TJSONObject(aObj), nil, e, true
                )
              else if aObj is TJSONArray then
                TLogger.GetInstance().Log(
                  TLogLevel.llFailure,
                  'mongo_insert_array',
                  'Trying to Insert doc into Collection: '+Self.FCollection,
                  TJsonObject(TJSONObject.ParseJSONValue('{"obj_error":'+aObj.ToJSON+'}')), nil, e, true
                );
            end;
        end;
      finally
        _Doc.Free;
      end;
    end;
end;

function TFUPMongoData.UpdateObject(aObj: TJSONValue): TJSONValue;
begin
  Result := nil;
end;

end.
