unit forup.constants;

interface
uses System.Classes, System.SysUtils, System.StrUtils, System.Math, System.IOUtils;

const
  CONF_DB_ENV = 'cfg.ini';
  PG_KEY = 'POSTGREDB';
  MONGO_KEY = 'MONGODB';

type
  TDBConstants = class
    public
      class function PGDriver(fullPath : Boolean = true) : String;
      class function MongoDriver(fullPath : Boolean = true) : String;
      class function MySQLDriver(fullPath : Boolean = true) : String;

      class function PG_Admin_Pwd : String;
      class function Mongo_Admin_Pwd : String;
  end;
implementation

{ TDrvPath }

class function TDBConstants.MongoDriver(fullPath : Boolean): String;
begin
  Result := TPath.Combine('drv',IfThen(fullPath,'mongo',EmptyStr));
end;

class function TDBConstants.Mongo_Admin_Pwd: String;
begin
  Result := 'n45fg98sd#@!';
end;

class function TDBConstants.MySQLDriver(fullPath : Boolean): String;
begin
  Result := TPath.Combine('drv',IfThen(fullPath,'mysql',EmptyStr));
end;

class function TDBConstants.PGDriver(fullPath : Boolean): String;
begin
  Result := TPath.Combine('drv',IfThen(fullPath,'pg'+TPath.DirectorySeparatorChar+'lib',EmptyStr));
end;

class function TDBConstants.PG_Admin_Pwd: String;
begin
  Result := 'N45fg98sd#@!';
end;

end.
