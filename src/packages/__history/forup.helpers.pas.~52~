procedure TJSONHelper.ConvertJsonArray(const AJsonObject: TJSONArray;
  AMongoDocument: TMongoDocument);
var
  aVal : TJSONValue;
  aNum : Extended;
  i : Integer;
begin
  for i := 0 to AJsonObject.Count-1 do
    begin
      aVal := AJsonObject.Items[i];

      if aVal is TJSONString then
        AMongoDocument.Add(EmptyStr, aVal.Value)
      else if aVal is TJSONNumber then
        begin
          aNum := aVal.GetValue<Extended>;
          AMongoDocument.Add(EmptyStr, aNum)
        end
      else if aVal is TJSONObject then
        begin
          AMongoDocument.BeginObject(EmptyStr);
          ConvertJsonObject(TJSONObject(aVal), AMongoDocument);
          AMongoDocument.EndObject;
        end
      else if aVal is TJSONArray then
        begin
          AMongoDocument.BeginArray(EmptyStr);
          ConvertJsonArray(TJSONArray(aVal), AMongoDocument);
          AMongoDocument.EndArray;
        end
      else if aVal is TJSONTrue then
        AMongoDocument.Add(EmptyStr, true)
      else if aVal is TJSONFalse then
        AMongoDocument.Add(EmptyStr, false)
      else if aVal is TJSONNull then
        AMongoDocument.AddNull(EmptyStr)
      else
        begin
          AMongoDocument.Add('Array Item: '+i.ToString,
            'Unknown JsonType for property. Value found -> '+aVal.ToString);
        end;
    end;
end;

procedure TJSONHelper.ConvertJsonObject(const AJsonObject: TJSONObject;
  AMongoDocument: TMongoDocument);
var
  aPair : TJSONPair;
  aValue : TJSONValue;
  aNestedDoc : TMongoDocument;
  aExtValue : Extended;
begin
  for aPair in AJsonObject do
    begin
      aValue := aPair.JsonValue;
      try
        if aValue is TJSONString then
          AMongoDocument.Add(aPair.JsonString.Value, aValue.Value)
        else if aValue is TJSONNumber then
          begin
            if aPair.JsonString.Value.Contains('timestamp') then
              begin

              end
            else
              begin
                aExtValue := aValue.GetValue<Extended>;
                AMongoDocument.Add(aPair.JsonString.Value, aExtValue);
              end;
          end
        else if aValue is TJSONObject then
          begin
            aNestedDoc := AMongoDocument.BeginObject(aPair.JsonString.Value);
            ConvertJsonObject(TJSONObject(aValue), aNestedDoc);
            aNestedDoc.EndObject;
          end
        else if aValue is TJSONArray then
          begin
            aNestedDoc := AMongoDocument.BeginArray(aPair.JsonString.Value);
            ConvertJsonArray(TJSONArray(aValue), aNestedDoc);
            aNestedDoc.EndArray;
          end
        else if aValue is TJSONTrue then
          AMongoDocument.Add(aPair.JsonString.Value, true)
        else if aValue is TJSONFalse then
          AMongoDocument.Add(aPair.JsonString.Value, false)
        else if aValue is TJSONNull then
          AMongoDocument.Add(aPair.JsonString.Value, null)
        else
          begin
            AMongoDocument.Add(aPair.JsonString.Value,
              'Unknown JsonType for property. Value found -> '+aValue.Value);
          end;

        if Assigned(aNestedDoc) then
          aNestedDoc.Free;
      except
        on e : exception do
          begin
            TLogger.GetInstance().Log(TLogLevel.llFailure, 'parse_to_mongodocument', 'Trying to parse JSONValue to '+
            'MongoDocument', TJSONObject(TJSONObject.ParseJSONValue(AMongoDocument.AsJSON)), nil, e);
          end;
      end;
    end;

  aValue.Free;
  aPair.Free;
end;

function TJSONHelper.DictionaryToJSON(
  aDic: TDictionary<string, string>): TJSONValue;
var
  strWriter  : TStringWriter;
  jsonWriter : TJsonTextWriter;
  aPair : TPair<string, string>;
begin
  strWriter := TStringWriter.Create;
  jsonWriter := TJsonTextWriter.Create(strWriter);
  try
    jsonWriter.Formatting := TJsonFormatting.Indented;
    jsonWriter.WriteStartObject;
    for aPair in aDic do
      begin
        jsonWriter.WritePropertyName(aPair.Key);
        jsonWriter.WriteRaw(aPair.Value);
      end;
    jsonWriter.WriteEndObject;

    Result := TJSONObject.ParseJSONValue(strWriter.ToString);
  except
    on e : exception do
      begin
        TLogger.GetInstance().Log(llFailure, 'dictionary_to_json', 'Fail to build JSON', nil, nil,
        e);
        Result := TJSONObject.ParseJSONValue('{}');
      end;
  end;
end;

function TJSONHelper.GetMongoDocument(aEnv: TMongoEnv): TMongoDocument;
var
  aNewDoc : TMongoDocument;
begin
  aNewDoc := aEnv.NewDoc;
  if Self is TJSONObject then
    begin
      ConvertJsonObject((Self as TJSONObject), aNewDoc);
    end
  else if Self is TJSONArray then
    begin
      ConvertJsonArray((Self as TJSONArray), aNewDoc);
    end;
  Result := aNewDoc;
end;

{ TFUPStringHelper }

class function TFUPFuncHelper.AlphaNumeric(const S : String; aCase : TCharCase) : String;
var
  aNewStr : String;
  i : Integer;
begin
  aNewStr := EmptyStr;
  for i := 1 to Length(S) do
    begin
      if (S[i] in ['0'..'9']) or (S[i] in ['a'..'z']) or
       (S[i] in ['A'..'Z']) then
      begin
        aNewStr := aNewStr + S[i];
      end;
    end;

  case aCase of
    tccUpper: Result := UpperCase(aNewStr);
    tccLower: Result := LowerCase(aNewStr);
  end;

end;

