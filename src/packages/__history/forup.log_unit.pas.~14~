procedure TLogger.WriteToDisk(const ALogEntry: TJSONObject);
var
  LFileStream: TFileStream;
  LContent: string;
  LBytes: TBytes;
begin
  {
    SEGURANÇA E CONCORRÊNCIA:
    1. Uso de CriticalSection para evitar que múltiplas threads acessem o arquivo simultaneamente.
    2. TFileStream com fmShareDenyWrite garante que apenas este processo escreva no momento.
    3. Escrita no final do arquivo (Append).
  }
  FCriticalSection.Enter;
  try
    LContent := ALogEntry.ToJSON + sLineBreak;
    LBytes := TEncoding.UTF8.GetBytes(LContent);

    if not TFile.Exists(FLogFilePath) then
      LFileStream := TFileStream.Create(FLogFilePath, fmCreate)
    else
      LFileStream := TFileStream.Create(FLogFilePath, fmOpenWrite or fmShareDenyWrite);

    try
      LFileStream.Seek(0, TSeekOrigin.soEnd);
      LFileStream.WriteBuffer(LBytes[0], Length(LBytes));
    finally
      LFileStream.Free;
    end;
  finally
    FCriticalSection.Leave;
  end;
end;

end.
