unit forup.log_unit;

interface
uses System.Classes, System.JSON, System.JSON.BSON, System.StrUtils,
System.SysUtils, System.IOUtils, forup.main_connection, forup.constants,
Generics.Collections, System.Math, System.DateUtils, System.SyncObjs;

type
  TLogLevel = (llSuccess, llFailure, llChange);

  TLogger = class
    private
    FLogFilePath: string;
    FServiceName: string;
    FCriticalSection: TCriticalSection;
    class var FInstance: TLogger;

    procedure WriteToDisk(const ALogEntry: TJSONObject);
    function TryWriteToMongoDB(const ALogEntry: TJSONObject): Boolean;
    function BuildLogObject(ALevel: TLogLevel; const AAction, AMessage: string;
      ADataBefore, ADataAfter: TJSONObject; AException: Exception): TJSONObject;
  public
    constructor Create(const AServiceName: string);
    destructor Destroy; override;

    class function GetInstance: TLogger;

    procedure Log(ALevel: TLogLevel; const AAction: string; const AMessage: string = '';
      ADataBefore: TJSONObject = nil; ADataAfter: TJSONObject = nil; AException: Exception = nil);

    property LogFilePath: string read FLogFilePath write FLogFilePath;
  end;

implementation

{ TLogger }

function TLogger.BuildLogObject(ALevel: TLogLevel; const AAction,
  AMessage: string; ADataBefore, ADataAfter: TJSONObject;
  AException: Exception): TJSONObject;
const
  LevelNames: array[TLogLevel] of string = ('SUCCESS', 'FAILURE', 'CHANGE');
begin
  Result := TJSONObject.Create;
  try
    Result.AddPair('timestamp', TTimeZone.Local.ToUniversalTime(Now));
    Result.AddPair('level', LevelNames[ALevel]);
    Result.AddPair('service', FServiceName);
    Result.AddPair('action', AAction);

    if AMessage <> '' then
      Result.AddPair('message', AMessage);

    if Assigned(ADataBefore) then
      Result.AddPair('data_before', ADataBefore.Clone as TJSONObject);

    if Assigned(ADataAfter) then
      Result.AddPair('data_after', ADataAfter.Clone as TJSONObject);

    if Assigned(AException) then
    begin
      var LError := TJSONObject.Create;
      LError.AddPair('type', AException.ClassName);
      LError.AddPair('msg', AException.Message);
      Result.AddPair('exception', LError);
    end;
  except
    on E: Exception do
    begin
      Result.Free;
      raise;
    end;
  end;
end;

constructor TLogger.Create(const AServiceName: string);
begin
  inherited Create;
  FServiceName := AServiceName;
  FCriticalSection := TCriticalSection.Create;
  // Define caminho padrão seguro (ex: pasta de dados da aplicação)
  FLogFilePath := TPath.Combine(TPath.GetPublicPath, 'logs');
  if not TDirectory.Exists(FLogFilePath) then
    TDirectory.CreateDirectory(FLogFilePath);

  FLogFilePath := TPath.Combine(FLogFilePath, 'system_fallback.log');
end;

destructor TLogger.Destroy;
begin
  FCriticalSection.Free;
  inherited;
end;

class function TLogger.GetInstance: TLogger;
begin
  if not Assigned(FInstance) then
    FInstance := TLogger.Create('fup_omini_service');
  Result := FInstance;
end;

procedure TLogger.Log(ALevel: TLogLevel; const AAction, AMessage: string;
  ADataBefore, ADataAfter: TJSONObject; AException: Exception);
begin

end;

