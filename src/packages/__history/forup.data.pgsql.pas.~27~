function TFUPPGData.GetObject(aID: string; aFrom : string): TJSONValue;
var
  pgQry : TFDQuery;
begin
  try
    pgQry := TFDQuery.Create(nil);
    if main_connection.TryPGConnect() then
      begin
        pgQry.Connection := main_connection.PGConnection;
        with pgQry do
          begin
            Close;
            Sql.Clear;
            Sql.Add('SELECT * FROM '+aFrom);
            Sql.Add('WHERE _id = :ID');
            Params.ParamByName('ID').Value := aID;
            Prepare;

            try
              Open;
              Result := SuccessResult(
                RecordCount.ToString+' selected',
                TDataSet(pgQry).ToJSONObject() //Helper DataSet to JSON
              );
              Close;
            except
              on e : Exception do
                begin
                  TLogger.GetInstance().Log(TLogLevel.llFailure, 'GetObject', 'ID = '+aID+';FROM = '+aFrom,
                  nil, nil, e);
                  Result := ErrorResult('Error Selecting ID ('+aID+') FROM ('+aFrom+')', nil);
                end;
            end;
          end;
      end;
  finally
    pgQry.Free;
  end;
end;

function TFUPPGData.GetObjects(aFilter: TJSONValue): TJSONValue;
var
  pgQry : TFDQuery;
  LFields : String;
  LFrom : String;
begin
  try
    pgQry := TFDQuery.Create(nil);
    if main_connection.TryPGConnect() then
      begin
        pgQry.Connection := main_connection.PGConnection;
        with pgQry do
          begin
            Close;
            Sql.Clear;
            try
              LFields := '*';
              if aFilter.TryGetValue<String>('fields',LFields) then
                begin
                  if LFields.IsEmpty then
                    LFields := '*';
                end;

              LFrom := EmptyStr;
              if not aFilter.TryGetValue<String>('from',LFrom) then
                begin
                  raise Exception.Create('Not found [from] property at filter.');
                end
              else if LFrom.IsEmpty then
                begin
                  raise Exception.Create('Property [from] empty at filter.');
                end;

              Sql.Add('SELECT '+LFields+' FROM '+LFrom);

              if aFilter.BuildSQLClause(pgQry) then
                begin
                  Prepare;
                end
              else
                begin
                  raise Exception.Create('Criteria not builted.');
                end;

              Open;
              Result := SuccessResult(
                RecordCount.ToString+' selected',
                TDataSet(pgQry).ToJSONObject() //Helper DataSet to JSON
              );
              Close;
            except
              on e : Exception do
                begin
                  TLogger.GetInstance().Log(TLogLevel.llFailure, 'GetObjects', 'Can''t build select statement',
                  TJSONObject(aFilter), nil, e);
                  Result := ErrorResult('Error building select statement', nil);
                end;
            end;
          end;
      end;
  finally
    pgQry.Free;
  end;
end;

