function TFUPDataAcces.ErrorResult(aMessage : string; aObj: TJSONValue): TJSONValue;
var
  strWriter: TStringWriter;
  jsonWriter: TJsonTextWriter;
begin
  strWriter := TStringWriter.Create;
  jsonWriter := TJsonTextWriter.Create(strWriter);
  try
    jsonWriter.Formatting := TJsonFormatting.Indented;

    jsonWriter.WriteStartObject;
    jsonWriter.WritePropertyName('result');
    jsonWriter.WriteValue('error');
    jsonWriter.WritePropertyName('message');
    jsonWriter.WriteValue(aMessage);
    jsonWriter.WritePropertyName('data_result');
    jsonWriter.WriteRaw(aObj.ToJSON());
    jsonWriter.WriteEndObject;
  except
    on e : exception do
      begin
        TLogger.GetInstance().Log(llFailure, 'build_error_result', aMessage, nil, nil, e)
      end;
  end;
end;

