unit forup.assync.data;

interface
uses forup.assync.datainf, System.Classes, System.StrUtils, System.SysUtils,
System.Threading, System.Math, System.JSON, System.JSON.BSON, System.Generics.Collections,
forup.main_connection;

type
  TDBThread = class(TThread)
  protected
    FConnDefName: string;
    FSQL: TStringList;
    procedure Execute; override;

  published
    property ConnDefName: string read FConnDefName write FConnDefName;
    property SQL: TStringList read FSQL write FSQL;
  end;

implementation

{ TDBThread }

procedure TDBThread.Execute;
begin
  FreeOnTerminate := false;

end;

end.
