unit core.db.connection.firedac.base;

interface
uses core.db.connection.intf, core.connection, System.SysUtils, System.Math, System.Classes,
  Data.DB, FireDAC.Comp.Client,  FireDAC.Stan.Intf,  FireDAC.Stan.Param,  FireDAC.Stan.Option,
  FireDAC.Stan.Error,  FireDAC.DatS,  FireDAC.Phys.Intf,  FireDAC.DApt.Intf,  FireDAC.DApt,
  FireDAC.Stan.Async, System.SyncObjs, System.Rtti, Generics.Collections, System.Variants;

type
  TBaseFireDACConnAdapter = class(TInterfacedObject, IFUPConnection)
    private
      FConn : TFDConnection;
      FInTransaction: Boolean;
      FCritical: TCriticalSection;
      FConnectionName: string;
      procedure BindParams(AParams: TFDParams; const AValues : TDictionary<string, TValue>);
    public
      constructor Create(const AConnDef : string);
      destructor Destroy; override;
      function StartTransaction: Boolean;
      function Commit: Boolean;
      function Rollback: Boolean;

      function Execute(const ASQL: string; const AParams: TDictionary<string, TValue>): Integer;
      function Query(const ASQL: string; const AParams: TDictionary<string, TValue>): TDataSet;

      function GetIsInTransaction: Boolean;
      function GetConnectionName: string;
  end;

implementation

{ TBaseFireDACConnAdapter }

procedure TBaseFireDACConnAdapter.BindParams(AParams: TFDParams;
  const AValues : TDictionary<string, TValue>);
var
  I: Integer;
  ParamName: string;
  AValue : TPair<string, TValue>;
  ParamValue: TValue;
  Param: TFDParam;
begin
  for AValue in AValues do
  begin
    ParamName := AValue.Key;
    ParamValue := AValue.Value;

    Param := AParams.FindParam(ParamName);

    if Assigned(Param) then
      Param.Value := ParamValue.AsVariant
    else
      raise Exception.CreateFmt('[FUPAdapter][Parameter]="%s" not found.', [ParamName]);
  end;
end;

function TBaseFireDACConnAdapter.Commit: Boolean;
begin
  FCritical.Acquire;
  try
    if FInTransaction then
    begin
      FConn.Commit;
      FInTransaction := False;
    end;
    Result := True;
  finally
    FCritical.Release;
  end;
end;

constructor TBaseFireDACConnAdapter.Create(const AConnDef: string);
begin
  inherited Create;
  FCritical := TCriticalSection.Create;
  FConn := TFDConnection.Create(nil);
  FConnectionName := AConnDef;
  FConn.ConnectionDefName := AConnDef;
  FConn.LoginPrompt := False;
  try
    FConn.Connected := True;
  except
    on e : exception do
      begin

      end;
  end;
end;

destructor TBaseFireDACConnAdapter.Destroy;
begin
  FCritical.Acquire;
  try
    if FConn.Connected then
      FConn.Connected := False;
    FConn.Free;
  finally
    FCritical.Release;
    FCritical.Free;
    inherited;
  end;
end;

function TBaseFireDACConnAdapter.Execute(const ASQL: string;
  const AParams: TDictionary<string, TValue>): Integer;
var
  aCMD : TFDCommand;
begin
  FCritical.Acquire;
  Result := -1;
  try
    aCMD := TFDCommand.Create(nil);
    try
      aCMD.Connection := FConn;
      aCMD.CommandText.Add(ASQL);
      BindParams(aCMD.Params, AParams);
      aCMD.Prepare();
      aCMD.Execute();
      aCMD.Unprepare;
      Result := aCMD.RowsAffected;
      aCMD.Free;
    except
      on e : exception do
        begin
          aCMD.Free;
        end;
    end;
  finally
    FCritical.Release;
  end;
end;

function TBaseFireDACConnAdapter.GetConnectionName: string;
begin
  Result := Self.FConnectionName;
end;

function TBaseFireDACConnAdapter.GetIsInTransaction: Boolean;
begin
  Result := Self.FInTransaction;
end;

function TBaseFireDACConnAdapter.Query(const ASQL: string;
  const AParams: TDictionary<string, TValue>): TDataSet;
var
  Qry : TFDQuery;
begin
  FCritical.Acquire;
  Result := TDataSet.Create(nil);
  try
    Qry := TFDQuery.Create(nil);
    Qry.Connection := FConn;
    Qry.Sql.Text := ASQL;
    try
      BindParams(Qry.Params, AParams);
      Qry.Prepare;
      Qry.Open();
      Qry.Unprepare;
      Result := Qry;
    except
      on e : exception do
        begin

        end;
    end;
  finally
    FCritical.Release;
  end;

end;

function TBaseFireDACConnAdapter.Rollback: Boolean;
begin
  FCritical.Acquire;
  try
    if FInTransaction then
    begin
      FConn.Rollback;
      FInTransaction := False;
    end;
    Result := True;
  finally
    FCritical.Release;
  end;
end;

function TBaseFireDACConnAdapter.StartTransaction: Boolean;
begin
  FCritical.Acquire;
  try
    if not FInTransaction then
    begin
      FConn.StartTransaction;
      FInTransaction := True;
    end;
    Result := True;
  finally
    FCritical.Release;
  end;
end;

end.
