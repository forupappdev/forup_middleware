unit forup.model.user;

interface
uses forup.util.types, forup.util.constants, forup.util.functions, core.sql.attributes,
core.sql.entity;

var
  _PrimaryKey : PrimaryKey;

type
  {$M+}
  [Table('auth_database','user','Unify the User login between modules')]
  [_PrimaryKey]
  [Index('idx_user_email', 'user', 'email', Ascending, 'auth_database')]
  TUser = class(TBaseEntity)
  private
    FId: string;
    FUsername: string;
    FFullname: string;
    FEmail: string;
    FPassword: string;
    FCreated_at: TDateTime;
    FUpdated_at: TDateTime;
    FDeleted_at: TDateTime;

  public
    class procedure RegisterClass; override;

  published
    [Column('uid',tdChar,255, 'Unique ID for User', [doSelect], [NoInsert, Unique])]
    [TPK('uid', tdChar, Insert)]
    property Uid: string read FId write FId;

    [Column('username',tdChar,255, 'Short User name', [doInsert, doUpdate, doSelect])]
    property Username: string read FUsername write FUsername;

    [Column('fullname',tdChar,255, 'User full name', [doInsert, doUpdate, doSelect])]
    property Fullname: string read FFullname write FFullname;

    [Column('email',tdChar,255, 'User email, used for login', [doAll, doValidate], [Unique])]
    property Email: string read FEmail write FEmail;

    [Column('password',tdChar,255, 'User Password', [doInsert, doUpdate], [Hidden])]
    property Password: string read FPassword write FPassword;

    [Column('created_at', tdDateTime, 20, 'When User is created', [doSelect, doInsert])]
    property Created_at: TDateTime read FCreated_at write FCreated_at;

    [Column('updated_at', tdDateTime, 20, 'When User is updated', [doSelect, doUpdate])]
    property Updated_at: TDateTime read FUpdated_at write FUpdated_at;

    [Column('deleted_at', tdDateTime, 20, 'Used for softdeletes' , [doSelect, doUpdate])]
    property Deleted_at: TDateTime read FDeleted_at write FDeleted_at;

  end;

implementation

{ TUser }

class procedure TUser.RegisterClass;
var
  aPK : TPK;
begin
  inherited;
  aPK := TPK.Create('uid', tdChar, Insert);
  _PrimaryKey := PrimaryKey.Create();
  _PrimaryKey.Add(aPK);
end;

initialization
  TUser.RegisterClass;

end.
